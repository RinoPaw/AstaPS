/* REVIEW DRAFT only: representative Mondstadt combat family from historical Server/DropTable.
 * Six thresholds: 1, 6, 11, 16, 21, 26 (ChestLevelSetConfigData).
 * The source does NOT prove these are the right roots for other regions or puzzle chests.
 * CSS currently cannot distinguish combat/puzzle reliably. Do not deploy as production rules.
 */

chest[kind="common"] {
    --loot: common_chest_light;
    --genshin-item-adventure_exp: 10;
    --genshin-item-sigil: 1;
    --genshin-item-primogem: 0;
}

chest[kind="exquisite"] {
    --loot: exquisite_chest_light;
    --genshin-item-adventure_exp: 20;
    --genshin-item-sigil: 3;
    --genshin-item-primogem: 2;
}

chest[kind="precious"] {
    --loot: precious_chest_light;
    --genshin-item-adventure_exp: 30;
    --genshin-item-sigil: 4;
    --genshin-item-primogem: 5;
}

chest[kind="luxurious"] {
    --loot: luxurious_chest_light;
    --genshin-item-adventure_exp: 30;
    --genshin-item-sigil: 5;
    --genshin-item-primogem: 10;
}

/* Historical battle source root 51010000; level 1~5. */
chest[kind="common"][level="1~5"] {
    --loot: common_chest_light;
