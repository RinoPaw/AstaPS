/* Review draft: historical Mondstadt combat rewards; not verified for other sources. */

chest[kind="common"] {
    --genshin-item-adventure_exp: 10;
    --genshin-item-sigil: 1;
    --genshin-item-primogem: 2;
}

chest[kind="common"][level="1~5"] {
    --loot: common_chest_light;
}

chest[kind="common"][level="6~10"] {
    --loot: common_chest_low;
}

chest[kind="common"][level="11~15"] {
    --loot: common_chest_medium;
    --genshin-item-sigil: 2;
}

chest[kind="common"][level="16~20"] {
    --loot: common_chest_high;
    --genshin-item-adventure_exp: 20;
    --genshin-item-sigil: 2;
}

chest[kind="common"][level="21~25"] {
    --loot: common_chest_xhigh;
    --genshin-item-adventure_exp: 20;
    --genshin-item-sigil: 3;
}

chest[kind="common"][level="26~"] {
    --loot: common_chest_max;
    --genshin-item-adventure_exp: 20;
    --genshin-item-sigil: 3;
}

chest[kind="exquisite"] {
    --genshin-item-adventure_exp: 20;
    --genshin-item-sigil: 3;
    --genshin-item-primogem: 5;
}

chest[kind="exquisite"][level="1~5"] {
    --loot: exquisite_chest_light;
}

chest[kind="exquisite"][level="6~10"] {
    --loot: exquisite_chest_low;
}

chest[kind="exquisite"][level="11~15"] {
    --loot: exquisite_chest_medium;
}

chest[kind="exquisite"][level="16~20"] {
    --loot: exquisite_chest_high;
}

chest[kind="exquisite"][level="21~25"] {
    --loot: exquisite_chest_xhigh;
    --genshin-item-sigil: 4;
}

chest[kind="exquisite"][level="26~"] {
    --loot: exquisite_chest_max;
    --genshin-item-adventure_exp: 30;
    --genshin-item-sigil: 4;
}

chest[kind="precious"] {
    --genshin-item-adventure_exp: 30;
    --genshin-item-sigil: 4;
    --genshin-item-primogem: 10;
}

chest[kind="precious"][level="1~5"] {
    --loot: precious_chest_light;
}

chest[kind="precious"][level="6~10"] {
    --loot: precious_chest_low;
}

chest[kind="precious"][level="11~15"] {
    --loot: precious_chest_medium;
}

chest[kind="precious"][level="16~20"] {
    --loot: precious_chest_high;
}

chest[kind="precious"][level="21~25"] {
    --loot: precious_chest_xhigh;
    --genshin-item-sigil: 5;
}

chest[kind="precious"][level="26~"] {
    --loot: precious_chest_max;
    --genshin-item-sigil: 5;
}

chest[kind="luxurious"] {
    --genshin-item-adventure_exp: 30;
    --genshin-item-sigil: 5;
    --genshin-item-primogem: 10;
}

chest[kind="luxurious"][level="1~5"] {
    --loot: luxurious_chest_light;
}

chest[kind="luxurious"][level="6~10"] {
    --loot: luxurious_chest_low;
}

chest[kind="luxurious"][level="11~15"] {
    --loot: luxurious_chest_medium;
}

chest[kind="luxurious"][level="16~20"] {
    --loot: luxurious_chest_high;
}

chest[kind="luxurious"][level="21~25"] {
    --loot: luxurious_chest_xhigh;
    --genshin-item-sigil: 6;
}

chest[kind="luxurious"][level="26~"] {
    --loot: luxurious_chest_max;
    --genshin-item-sigil: 6;
}

/* Older Mondstadt and Liyue chests use fewer Primogems. */

chest[kind="common"][city="1"],
chest[kind="common"][city="2"] {
    --genshin-item-primogem: 0;
}

chest[kind="exquisite"][city="1"],
chest[kind="exquisite"][city="2"] {
    --genshin-item-primogem: 2;
}

chest[kind="precious"][city="1"],
chest[kind="precious"][city="2"] {
    --genshin-item-primogem: 5;
}

/* Higher-value areas in those nations; child-area exceptions need source data. */

chest[kind="common"][city="1"][area="10"],
chest[kind="common"][city="1"][area="77"],
chest[kind="common"][city="2"][area="8"],
chest[kind="common"][city="2"][area="19"],
chest[kind="common"][city="2"][area="40"],
chest[kind="common"][city="2"][area="41"],
chest[kind="common"][city="2"][area="47"],
chest[kind="common"][city="2"][area="300"] {
    --genshin-item-primogem: 2;
}

chest[kind="exquisite"][city="1"][area="10"],
chest[kind="exquisite"][city="1"][area="77"],
chest[kind="exquisite"][city="2"][area="8"],
chest[kind="exquisite"][city="2"][area="19"],
chest[kind="exquisite"][city="2"][area="40"],
chest[kind="exquisite"][city="2"][area="41"],
chest[kind="exquisite"][city="2"][area="47"],
chest[kind="exquisite"][city="2"][area="300"] {
    --genshin-item-primogem: 5;
}

chest[kind="precious"][city="1"][area="10"],
chest[kind="precious"][city="1"][area="77"],
chest[kind="precious"][city="2"][area="8"],
chest[kind="precious"][city="2"][area="19"],
chest[kind="precious"][city="2"][area="40"],
chest[kind="precious"][city="2"][area="41"],
chest[kind="precious"][city="2"][area="47"],
chest[kind="precious"][city="2"][area="300"] {
    --genshin-item-primogem: 10;
}

transpoint[kind="waypoint"],
transpoint[kind="statue"],
transpoint[kind="domain"] {
    --genshin-item-adventure_exp: 50;
    --genshin-item-primogem: 5;
}

/* Tutorial waypoint, scene 3, point 6. */
transpoint[scene="3"][point="6"] {
    --genshin-item-adventure_exp: 10;
    --genshin-item-primogem: 0;
}

/* Three Realms Gateway Offering, scene 7. */
transpoint[scene="7"] {
    --loot: three_realms_point;
    --genshin-item-adventure_exp: 0;
    --genshin-item-primogem: 5;
}
